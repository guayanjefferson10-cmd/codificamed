# ============================================================
# CodificaMed - configuración de ejemplo
# Copia este archivo como .env y completa tus valores:
#     cp .env.example .env
# NUNCA subas el archivo .env al repositorio (está en .gitignore).
# ============================================================

# Proveedor de LLM activo:
#   ollama    -> modelo local (no envía datos fuera del equipo)
#   anthropic -> API de Claude
#   openai    -> API de OpenAI o compatible (Groq, OpenRouter, DeepSeek...)
#   rag       -> línea base sin LLM (solo recuperación semántica)
LLM_PROVIDER=ollama

# --- Modelo local (Ollama >= 0.5) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- API externa: Claude (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- API externa: OpenAI o compatible ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Deja vacío para OpenAI; para otra API compatible pon su URL, p. ej.:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_BASE_URL=

# --- Generación ---
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=300

# --- Recuperación (RAG) ---
# hibrido -> e5 + TF-IDF combinados (recomendado)
# e5      -> embeddings semánticos multilingual-e5-small
# tfidf   -> n-gramas de caracteres (no descarga modelos)
EMBEDDING_BACKEND=hibrido
EMBEDDING_MODEL=intfloat/multilingual-e5-small
TOP_K=8
MAX_CANDIDATOS=60
# Umbral de similitud de la línea base "rag" (vacío = automático)
UMBRAL_BASELINE=

# --- Negación ---
# hibrida -> NegEx corrige al LLM si confirma algo que la nota niega
# llm     -> solo decide el LLM
NEGACION_POLITICA=hibrida

# --- Costos opcionales para estimar el gasto de la API (USD por millón de tokens) ---
PRECIO_ENTRADA_MTOK=0
PRECIO_SALIDA_MTOK=0
